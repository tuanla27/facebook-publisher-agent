{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/facebook-education-post/review-decision.schema.json",
  "title": "Human Review Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["post_job_id", "version", "decision", "reviewer_id", "reviewed_content_hash", "reviewed_asset_ids", "reviewed_asset_hash", "reviewed_at"],
  "properties": {
    "post_job_id": { "type": "string", "minLength": 3 },
    "version": { "type": "integer", "minimum": 1 },
    "decision": { "type": "string", "enum": ["APPROVED", "CHANGES_REQUESTED", "REJECTED"] },
    "selected_variant_id": { "type": "string", "minLength": 1 },
    "reviewer_id": { "type": "string", "minLength": 1 },
    "reviewer_role": { "type": "string", "enum": ["reviewer", "publisher", "admin"] },
    "reviewer_authenticated": { "const": true },
    "feedback": { "type": "string", "maxLength": 3000 },
    "reviewed_content_hash": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "reviewed_asset_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "reviewed_asset_hash": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "reviewed_page_id": { "type": "string", "minLength": 1 },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
