{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/facebook-education-post/review-decision.schema.json",
  "title": "Human Review Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["post_job_id", "version", "decision", "reviewer_id", "reviewed_content_hash", "reviewed_asset_ids", "reviewed_asset_hash", "reviewed_at"],
  "properties": {
    "post_job_id": { "type": "string", "minLength": 3 },
    "version": { "type": "integer", "minimum": 1 },
    "decision": { "type": "string", "enum": ["APPROVED", "CHANGES_REQUESTED", "REJECTED"] },
    "selected_variant_id": { "type": "string", "minLength": 1 },
    "reviewer_id": { "type": "string", "minLength": 1 },
    "reviewer_role": { "type": "string", "enum": ["reviewer", "publisher", "admin"] },
    "reviewer_authenticated": { "const": true },
    "feedback": { "type": "string", "maxLength": 3000 },
    "reviewed_content_hash": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "reviewed_asset_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "reviewed_asset_hash": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "reviewed_page_id": { "type": "string", "minLength": 1 },
    "institutional_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attester_id", "attester_role", "scopes", "confirmation_text", "confirmed_at", "backend_verified"],
      "properties": {
        "attester_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "attester_role": { "type": "string", "enum": ["faculty", "staff", "admin"] },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["admissions_scores", "admissions_dates", "admissions_procedure", "official_program_information"]
          }
        },
        "confirmation_text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "confirmed_at": { "type": "string", "format": "date-time" },
        "backend_verified": { "const": true }
      }
    },
    "reviewer_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code_id", "attester_id", "attester_role", "scopes", "confirmation_text", "code_consumed_at", "backend_verified"],
      "properties": {
        "code_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "attester_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "attester_role": { "type": "string", "enum": ["reviewer", "admin"] },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["admissions_scores", "admissions_dates", "admissions_procedure", "official_program_information"]
          }
        },
        "confirmation_text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "code_consumed_at": { "type": "string", "format": "date-time" },
        "backend_verified": { "const": true }
      }
    },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "identity_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism", "verified_at", "signature"],
      "properties": {
        "mechanism": { "type": "string", "enum": ["local_browser_review"] },
        "verified_at": { "type": "string", "format": "date-time" },
        "signature": { "type": "string", "pattern": "^hmac-sha256:[A-Za-z0-9_-]+={0,2}$" }
      }
    }
  }
}
