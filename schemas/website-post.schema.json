{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/facebook-education-post/website-post.schema.json",
  "title": "Website Article (Khoa Kinh tế HVNH — hvnh.edu.vn/eco)",
  "description": "Article for the school website. The site is a WebPart CMS without a public API, so the publisher exports this artifact to Word/HTML for the web team to paste manually. Voice follows config/professional-voice.yml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["post_job_id", "version", "title", "lead", "body", "channels", "content_hash", "status"],
  "properties": {
    "post_job_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,99}$" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 90 },
    "lead": { "type": "string", "minLength": 1, "maxLength": 280 },
    "body": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "text"],
        "properties": {
          "type": { "enum": ["h2", "h3", "p", "quote", "list"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "items": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "uri", "caption"],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "minLength": 1 },
          "caption": { "type": "string", "maxLength": 200 },
          "alt_text": { "type": "string", "maxLength": 300 },
          "placement": { "enum": ["featured", "inline", "gallery"] }
        }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "enum": ["facebook", "website"] },
      "uniqueItems": true
    },
    "intent": { "enum": ["education", "event_recap", "people_story", "admissions", "career", "community"] },
    "contact": { "type": "string", "maxLength": 300 },
    "source_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "needs_verification": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "content_hash": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "status": { "enum": ["DRAFT_GENERATED", "EXPORTED", "FAILED"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
