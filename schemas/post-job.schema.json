{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/facebook-education-post/post-job.schema.json",
  "title": "Facebook Education Post Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["post_job_id", "page", "keywords", "assets", "objective", "language", "status"],
  "properties": {
    "post_job_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,99}$" },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_id", "page_name", "allowlisted"],
      "properties": {
        "page_id": { "type": "string", "minLength": 1 },
        "page_name": { "type": "string", "minLength": 1 },
        "allowlisted": { "type": "boolean" }
      }
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "assets": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "kind", "uri", "publish"],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "kind": { "const": "image" },
          "uri": { "type": "string", "minLength": 1 },
          "asset_ref": { "type": "string", "pattern": "^asset://" },
          "publish": { "const": true },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "alt_context": { "type": "string", "maxLength": 1000 },
          "mime_type": { "type": "string", "pattern": "^image/" },
          "byte_size": { "type": "integer", "minimum": 1 },
          "width": { "type": ["integer", "null"], "minimum": 1 },
          "height": { "type": ["integer", "null"], "minimum": 1 },
          "scan_status": { "type": "string", "minLength": 1 },
          "source_type": { "enum": ["local_file", "host_original", "host_preview", "asset_reference"] },
          "original_or_preview": { "enum": ["original", "preview", "unknown"] }
        }
      }
    },
    "objective": {
      "type": "string",
      "enum": ["explain", "teach", "clarify", "awareness", "verified_product_education"]
    },
    "audience": { "type": "string", "maxLength": 500 },
    "language": { "type": "string", "enum": ["vi", "en"] },
    "tone": { "type": "string", "maxLength": 200 },
    "cta": { "type": "string", "maxLength": 300 },
    "verified_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "text", "source_refs"],
        "properties": {
          "fact_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_variants": { "type": "integer", "minimum": 1, "maximum": 5 },
        "max_body_characters": { "type": "integer", "minimum": 200, "maximum": 10000 },
        "must_include": { "type": "array", "items": { "type": "string" } },
        "must_avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": {
      "type": "string",
      "enum": ["CONVERSATIONAL_INTAKE", "ATTACHMENTS_RECEIVED", "ASSETS_MATERIALIZED", "INPUT_RECEIVED", "IMAGE_ANALYZED", "BRIEF_READY", "DRAFT_GENERATED", "POLICY_REVIEWED", "NEEDS_HUMAN_APPROVAL", "APPROVED", "CHANGES_REQUESTED", "REJECTED", "PUBLISHING", "PUBLISHED", "FAILED"]
    },
    "created_by": { "type": "string", "maxLength": 200 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ASSETS_MATERIALIZED",
              "INPUT_RECEIVED",
              "IMAGE_ANALYZED",
              "BRIEF_READY",
              "DRAFT_GENERATED",
              "POLICY_REVIEWED",
              "NEEDS_HUMAN_APPROVAL",
              "APPROVED",
              "CHANGES_REQUESTED",
              "REJECTED",
              "PUBLISHING",
              "PUBLISHED",
              "FAILED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "assets": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "ASSETS_MATERIALIZED" }
        }
      },
      "then": {
        "properties": {
          "assets": {
            "items": {
              "required": ["sha256", "mime_type", "byte_size", "width", "height", "scan_status", "source_type", "original_or_preview"],
              "properties": {
                "source_type": { "enum": ["local_file", "host_original"] },
                "original_or_preview": { "const": "original" }
              }
            }
          }
        }
      }
    }
  ]
}
