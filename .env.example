# Meta app configuration.
# App ID / Secret / Graph version can be entered in the local OAuth UI instead.
# If both exist, the UI-saved encrypted credentials win over .env.
# META_TOKEN_ENCRYPTION_KEY remains required in .env (encrypts local secrets).
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=vXX.X
META_OAUTH_REDIRECT_URI=https://localhost:8787/auth/callback
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts
# Required server-side allowlist. Comma-separated Page IDs.
META_ALLOWED_PAGE_IDS=
META_TARGET_PAGE_ID=
META_TARGET_PAGE_NAME=CuocthiPMC
META_TOKEN_ENCRYPTION_KEY=
META_OAUTH_HOST=localhost
META_OAUTH_PORT=8787
META_OAUTH_PUBLIC_ORIGIN=https://localhost:8787

# Local review page (single-owner approval). Generate with: openssl rand -hex 32
# The publisher refuses any approval.json without a valid signature from this key.
APPROVAL_SIGNING_KEY=
# Optional display identity recorded on approvals made from the local review page.
LOCAL_REVIEWER_ID=local-owner
# How long the local review page waits for a decision before closing (ms).
REVIEW_OPEN_TIMEOUT_MS=900000

# POC admin key. Generate with: npm run admin:key-hash
# Store only the hash here; enter the raw key via dialog or bootstrap script.
ADMIN_KEY_HASH=
ADMIN_STATE_PATH=.local/admin-bootstrap.json
META_TENANT_ID=local

# Optional PostgreSQL extension. The core local workflow does not require this.
DATABASE_URL=postgresql://localhost/facebook_education

# Publisher safety and retry policy.
ASSET_MAX_BYTES=10485760
ASSET_MIN_WIDTH=1080
ASSET_MIN_HEIGHT=0
# Asset malware scanning. Run `npm run setup:scanner` to detect ClamAV and
# fill these keys automatically. The wrapper bridges ClamAV's CLI to the
# JSON protocol the materializer expects.
ASSET_SCAN_REQUIRED=true
ASSET_SCANNER_BIN=node backend/assets/clamav-scanner.mjs
ASSET_SCANNER_ARGS=[]
ASSET_SCANNER_USE_CLAMDSCAN=true
CLAMSCAN_BIN=clamscan
CLAMDSCAN_BIN=clamdscan
META_RETRY_BASE_MS=5000
META_RETRY_MAX_MS=900000

# Google Drive planning source.
# Preferred for customers who cannot share files externally:
#   GOOGLE_DRIVE_AUTH_MODE=oauth
#   npm run google:connect
# The OAuth client secret stays in this local .env and is never sent in chat.
# Legacy fallback:
#   GOOGLE_DRIVE_AUTH_MODE=service_account
#   GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=.local/google-service-account.json
GOOGLE_DRIVE_AUTH_MODE=oauth
GOOGLE_DRIVE_AUTO_DISCOVER=true
GOOGLE_DRIVE_XLSX_MAX_BYTES=26214400
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8788/oauth2callback
GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=.local/google-service-account.json
GOOGLE_DRIVE_SHARED_FOLDER_ID=
GOOGLE_DRIVE_PLANS_SHEET_ID=1mGqRhfNwjRnEalZ3SGcSmFcZPw_MgLCEaSZE0PABMsc
# Page used when mapping a ready plan row to a post job (META_TARGET_* is set above).

# Facebook draft publishing (Giai đoạn 3). When FB_DRAFT_MODE=true, the
# publisher creates a Meta draft (published=false, unpublished_content_type=
# DRAFT) instead of a live post; the admin approves manually in Meta Business
# Suite. The local signed approval.json is skipped in draft mode.
FB_DRAFT_MODE=true
FB_DRAFT_MIN_IMAGES=2
